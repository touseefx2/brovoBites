# =============================================================================
# BRAVO BITES — ENV EXAMPLE (ek file) — copy values into the RIGHT local file below
# =============================================================================
#
# DEV  → apps/web/.env.development.local  (+ same values in .env.local)
#        Firebase: bravobites-dev   ImageKit: Bravo Bites DEV keys
#        Website: http://localhost:3001
#        Command: pnpm --filter web dev
#
# LIVE → apps/web/.env.production.local
#        Firebase: bravobites-live  ImageKit: Bravo Bites LIVE keys
#        Website: https://YOUR-APP.vercel.app  (+ same vars on Bravo Bites LIVE Vercel Production)
#        Command: pnpm --filter web build && pnpm --filter web start
#
# Firebase ids ship as placeholders. Set the real Bravo Bites ids once:
#   bash scripts/set-firebase-ids.sh <dev-project-id> <live-project-id>
#
# Guide: docs/ENV-SETUP.md
# =============================================================================

# --- pick one world (set correctly in each .local file) ---
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- Customer mode (hides Login button + blocks /login, /admin, /pos routes) ---
# "true" for customer-facing domain, "false" (or empty) for admin/staff
NEXT_PUBLIC_CUSTOMER_MODE=false

# --- Firebase WEB (⚙️ Project settings → General → Web app config) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=bravobites-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Menu images (FREE — Bravo Bites ImageKit account) ---
# https://imagekit.io → Developer options
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_ID
# Server-only (never commit / never NEXT_PUBLIC_):
IMAGEKIT_PRIVATE_KEY=
# optional folder root (default: bravobites/menu/…)
# IMAGEKIT_FOLDER=bravobites/menu
#
# Later if you enable Firebase Storage (Blaze):
# NEXT_PUBLIC_IMAGE_UPLOAD_PROVIDER=firebase

# --- Firebase ADMIN (⚙️ Service accounts → Generate key JSON) ---
FIREBASE_ADMIN_PROJECT_ID=bravobites-dev
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# LIVE tip: same variable NAMES, but project_id / keys from bravobites-live
# (+ Bravo Bites LIVE ImageKit keys) and NEXT_PUBLIC_APP_ENV=production + NEXT_PUBLIC_APP_URL=https://...
#
# Owner on LIVE (does not touch menu):
#   SEED_ENV=production pnpm create-owner -- --email=... --password=... --name=... --confirm=bravobites-live --primary
#
# Deploy: see DEPLOYMENT.md + deploy/targets.example.env

# --- Main owner (optional lock) ---
# Firebase Auth UID of the one Bravo Bites main owner. Co-owners cannot delete this account.
# If unset, the oldest owner is auto-flagged as primary on first owner API call.
# PRIMARY_OWNER_UID=

# --- Owner report by email (admin project only) ---
# Shop Gmail that sends the report + its 16-letter Gmail "app password".
# SMTP_USER=
# SMTP_PASS=
# Daily email job (Vercel Cron sends this as "Authorization: Bearer ...").
# CRON_SECRET=
