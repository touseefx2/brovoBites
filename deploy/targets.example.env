# Brovo Bites — copy to deploy/targets.local.env (gitignored) and fill IDs/tokens.
# Never commit tokens.
#
# Quick start — log in to Brovo Bites' Vercel into repo-local folders, then save:
#   vercel login --future -Q .tools/vercel-dev-auth     # Brovo Bites DEV Vercel account
#   bash scripts/save-vercel-token.sh dev  .tools/vercel-dev-auth
#   vercel login --future -Q .tools/vercel-live-auth    # Brovo Bites LIVE Vercel account
#   bash scripts/save-vercel-token.sh live .tools/vercel-live-auth
# Never a bare `vercel login` / `vercel link` here: this Mac's global Vercel
# login belongs to another shop.
#
# One Vercel account for both worlds is fine: same token + org id in both
# blocks, different project ids (DEV admin/menu vs LIVE admin/menu).
#
# Or paste tokens from https://vercel.com/account/tokens
#
# Deploy both domains:
#   pnpm deploy:dev:all     # DEV Firebase + DEV ImageKit (Vercel env)
#   CONFIRM_LIVE=1 pnpm deploy:live:all   # LIVE Firebase + LIVE ImageKit
#
# *_FIREBASE_PROJECT are placeholders until you run:
#   bash scripts/set-firebase-ids.sh <dev-project-id> <live-project-id>

# ─── DEV Vercel (Brovo Bites DEV — test Firebase: brovodev) ───
DEV_VERCEL_TOKEN=
DEV_VERCEL_ORG_ID=
DEV_VERCEL_PROJECT_ID_ADMIN=
DEV_VERCEL_PROJECT_ID_CUSTOMER=
DEV_FIREBASE_PROJECT=brovodev

# ─── LIVE Vercel (Brovo Bites LIVE — real shop Firebase: borovo-ffc56) ───
LIVE_VERCEL_TOKEN=
LIVE_VERCEL_ORG_ID=
LIVE_VERCEL_PROJECT_ID_ADMIN=
LIVE_VERCEL_PROJECT_ID_CUSTOMER=
LIVE_FIREBASE_PROJECT=borovo-ffc56
